# Scratch artifacts: EGM writes to .dev/docs (see AGENTS.md) and show-me writes
# its HTML files to .dev/show-me. `./build.sh check` allows the directory but
# still checks its contents, so keep nothing sensitive there.
.dev/

# Python bytecode from tools/check.py
__pycache__/
*.pyc

# Seeds are host-local by choice: ~/.config/agentbox/omp/models.yml and friends are personal
# config, so a copy must not land in this repo by accident. seed/ still works as a staging
# directory for ./build.sh deploy on this host; ./build.sh status reports the live files.
seed/
